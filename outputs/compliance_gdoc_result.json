        "insertText": {
          "location": {
            "index": 1281
          },
          "text": "If your business uses ChatGPT to draft client emails, automated chatbots for customer support, or AI algorithms for lead scoring, you are processing personal data under APP 1.7. \n"
        }
      },
      {
        "insertText": {
          "location": {
            "index": 1460
          },
          "text": "The OAIC is actively monitoring automated decisions. Using consumer-grade AI tools without proper data governance or privacy disclosures can result in significant exposure.\n"
